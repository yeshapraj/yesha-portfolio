---
layout: base.njk
permalink: /index.html
---
<header class="hero" id="top">
  <div class="w">
    <p class="kick">{{ site.kicker }}</p>
    <h1>
      <span class="msk"><span class="sm">{{ site.headSmall }}</span></span>
      <span class="msk"><span>{% if site.headLine2Italic %}{{ site.headLine2 | replace(site.headLine2Italic, '<span class="it">' + site.headLine2Italic + '</span>') | safe }}{% else %}{{ site.headLine2 }}{% endif %}</span></span>
      <span class="msk"><span>{{ site.headLine3 }}</span></span>
    </h1>
    <p class="sub fade">{{ site.sub | replace(site.subBold, '<b>' + site.subBold + '</b>') | safe if site.subBold else site.sub }}</p>

    {% if site.showStats %}<div class="nums fade">
      {% for s in site.stats %}<div><b>{{ s.figure }}</b><span>{{ s.label }}</span></div>
      {% endfor %}
    </div>{% endif %}
  </div>
</header>

<section id="work">
  <div class="w">
    {% for p in collections.projects %}{% if loop.first %}
    <article class="lead-case">
      <p class="tag rv">{{ site.workTag }} — {{ p.data.order | pad }}</p>
      <h2 class="rv"><a class="case-a" href="{{ '/work/' + (p.fileSlug | slugify) + '/' | url }}">{{ p.data.title | replace(p.data.titleItalic, '<em>' + p.data.titleItalic + '</em>') | safe if p.data.titleItalic else p.data.title }}</a></h2>
      <div class="lead-grid">
        <ul class="rv b">
          {% for pt in p.data.points %}<li>{{ pt.text }}</li>
          {% endfor %}
        </ul>
        <div class="wide rv b">
          {% if p.data.image %}<img src="{{ p.data.image }}" alt="{{ p.data.title }}" data-p>
          {% else %}<span data-p>{{ p.data.caption }}</span>{% endif %}
        </div>
      </div>
      <p class="rv b"><a class="more" href="{{ '/work/' + (p.fileSlug | slugify) + '/' | url }}"><span>Read the full case study</span></a></p>
    </article>
    {% else %}
    <article class="row rv">
      <div class="k">{{ p.data.order | pad }}</div>
      <div>
        <h3><a class="case-a" href="{{ '/work/' + (p.fileSlug | slugify) + '/' | url }}">{{ p.data.title }}</a></h3>
        <p class="who">{{ p.data.client }}</p>
      </div>
      <ul>
        {% for pt in p.data.points %}<li>{{ pt.text }}</li>
        {% endfor %}
      </ul>
    </article>
    {% endif %}{% endfor %}
  </div>
</section>

{% if site.showMethod %}<section class="method" id="method">
  <div class="w">
    <h2 class="rv">{{ site.methodHeading }} <em>{{ site.methodHeadingItalic }}</em>.</h2>
    <div class="mlist">
      {% for m in collections.method %}<div class="rv{% if loop.index % 2 == 0 %} b{% endif %}">
        <h4>{{ m.data.title }}</h4>
        <p>{{ m.data.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>{% endif %}

{% if site.showStatement %}<section class="say" id="about">
  <div class="w">
    <p id="say">{{ site.statement }} <em>{{ site.statementItalic }}</em>.</p>
  </div>
</section>{% endif %}

{% if site.showBio %}<div class="w">
  <div class="bio">
    <div>
      {% for b in site.bio %}<p class="rv{% if not loop.first %} b{% endif %}">{{ b.text }}</p>
      {% endfor %}
    </div>
    <div class="shot rv b">
      {% if site.photo %}<img src="{{ site.photo }}" alt="{{ site.name }}">
      {% else %}<div class="box">Portrait</div>{% endif %}
      {% if site.photoCaption %}<span class="cap">{{ site.photoCaption }}</span>{% endif %}
    </div>
  </div>
</div>{% endif %}

{% if site.showCareer %}<section class="jobs" id="career">
  <div class="w">
    {% for r in collections.roles %}<div class="job{% if r.data.current %} now{% endif %} rv">
      <h4>{{ r.data.title }}<small>{{ r.data.company }}</small>{% if r.data.summary %}<span class="sum">{{ r.data.summary }}</span>{% endif %}</h4>
      <time>{{ r.data.dates }}</time>
    </div>
    {% endfor %}
  </div>
</section>{% endif %}

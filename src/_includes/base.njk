<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }}, {{ site.name }}{% else %}{{ site.seoTitle }}{% endif %}</title>
<meta name="description" content="{% if description %}{{ description }}{% else %}{{ site.seoDesc }}{% endif %}">
<meta property="og:title" content="{% if title %}{{ title }}, {{ site.name }}{% else %}{{ site.seoTitle }}{% endif %}">
<meta property="og:description" content="{{ site.seoDesc }}">
<meta property="og:type" content="profile">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>

/*  TWO COLOURS. Everything below is mixed from these.
    --wine  ground
    --pink  everything that sits on it                       */
:root{
  --wine:{{ site.colorBg }};
  --pink:{{ site.colorAccent }};

  --shell:#35131F;
  --panel:#3D1A27;
  --line:#4E2A38;
  --dim:#9C7585;
  --muted:#B08899;
  --bright:#FAE7F0;
}
@supports (color: color-mix(in srgb, red, blue)){
:root{
  --shell:color-mix(in srgb, var(--pink) 5%, var(--wine));
  --panel:color-mix(in srgb, var(--pink) 9%, var(--wine));
  --line:color-mix(in srgb, var(--pink) 17%, var(--wine));
  --dim:color-mix(in srgb, var(--pink) 56%, var(--wine));
  --muted:color-mix(in srgb, var(--pink) 66%, var(--wine));
  --bright:color-mix(in srgb, #FFFFFF 55%, var(--pink));
}
}
:root{
  --serif:"Cormorant Garamond",Garamond,serif;
  --sans:"Jost",system-ui,sans-serif;
  --e:cubic-bezier(.22,1,.36,1);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--wine);color:var(--pink);
  font-family:var(--sans);font-size:16px;font-weight:300;line-height:1.7;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;
}
a{color:inherit}
img{max-width:100%;height:auto;display:block}
::selection{background:var(--pink);color:var(--wine)}
.w{width:100%;margin:0 auto;padding:0 22px}


/* ── nav ─────────────────────────────── */
#nav{position:fixed;inset:0 0 auto;z-index:60;padding:28px 0;
  transition:background .45s var(--e),box-shadow .45s var(--e);
  will-change:background}
#nav .w{transition:transform .45s var(--e);transform-origin:left center}
#nav.on .w{transform:scale(.94)}
#nav::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
  background:linear-gradient(to bottom,var(--wine) 0%,rgba(44,10,22,.92) 55%,rgba(44,10,22,0) 100%)}
#nav.on{background:rgba(44,10,22,.94);backdrop-filter:blur(16px);box-shadow:0 1px 0 var(--line)}
#nav .w{display:flex;align-items:center;justify-content:space-between;gap:24px}
.mark{font-family:var(--serif);font-size:21px;letter-spacing:.01em;text-decoration:none;white-space:nowrap}
.mark i{font-style:italic;color:var(--muted)}
.nl{display:none;gap:30px}
.nl a{font-size:10px;letter-spacing:.26em;text-transform:uppercase;text-decoration:none;color:var(--muted);transition:color .4s var(--e)}
.nl a:hover{color:var(--pink)}


/* ── hero: one dominant moment ───────── */
.hero{padding:124px 0 0;position:relative}
.hero .kick{
  font-size:10px;letter-spacing:.34em;text-transform:uppercase;color:var(--muted);
  margin:0 0 42px;display:flex;align-items:center;gap:16px;
}
.hero .kick::after{content:"";flex:1;height:1px;background:var(--line);max-width:190px}
h1{
  font-family:var(--serif);font-weight:300;margin:0;
  font-size:clamp(58px,12.5vw,186px);line-height:.82;letter-spacing:-.035em;
  color:var(--bright);
}
h1 .sm{display:block;font-size:.42em;letter-spacing:-.01em;line-height:1.1;color:var(--muted);margin-bottom:.16em}
h1 .it{font-style:italic;color:var(--pink)}
.msk{display:block;overflow:hidden;padding-bottom:.04em}
.msk > span{display:block;transform:translate3d(0,110%,0);transition:transform 1.2s var(--e)}
.go .msk > span{transform:translateY(0)}
.go .msk:nth-of-type(2) > span{transition-delay:.11s}
.go .msk:nth-of-type(3) > span{transition-delay:.22s}

.sub{
  margin:52px 0 0;max-width:30em;font-size:clamp(16px,1.75vw,20px);
  line-height:1.65;color:var(--muted);
}
.sub b{font-weight:400;color:var(--pink)}
.fade{opacity:0;transform:translate3d(0,18px,0);transition:opacity 1s var(--e) .55s,transform 1s var(--e) .55s}
.go .fade{opacity:1;transform:none}

/* ── hard numbers ────────────────────── */
.nums{display:grid;grid-template-columns:1fr 1fr;margin-top:52px;border-top:1px solid var(--line)}
.nums div{padding:20px 14px 22px 0;border-right:1px solid var(--line)}
.nums div:last-child{border-right:0}
.nums b{
  display:block;font-family:var(--serif);font-weight:300;
  font-size:clamp(38px,5vw,62px);line-height:.9;color:var(--bright);letter-spacing:-.03em;
}
.nums span{display:block;margin-top:10px;font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:var(--dim)}


/* ── statement: no eyebrow, no heading ─ */
.say{padding:92px 0 80px}
.say p{
  font-family:var(--serif);font-weight:300;margin:0;max-width:17em;
  font-size:clamp(30px,5.4vw,66px);line-height:1.12;letter-spacing:-.025em;color:var(--bright);
}
.say p em{font-style:italic;color:var(--pink)}
.say .wd{display:inline-block;opacity:.16;transition:opacity .6s var(--e)}
.say.lit .wd{opacity:1}

/* ── bio: asymmetric, photo breaks grid ─ */
.bio{display:grid;grid-template-columns:1fr;gap:42px;padding-bottom:84px}
.bio p{margin:0 0 22px;color:var(--muted);font-size:17px;max-width:46ch}
.bio p:first-child{color:var(--pink);font-size:19px}
.shot{position:relative;margin-top:0;max-width:300px}
.shot .box{
  aspect-ratio:4/5;background:var(--panel);border:1px solid var(--line);
  display:flex;align-items:center;justify-content:center;text-align:center;padding:26px;
  color:var(--dim);font-size:10px;letter-spacing:.24em;text-transform:uppercase;line-height:2.4;
}
.shot .cap{
  position:absolute;left:-30px;bottom:34px;background:var(--wine);
  padding:11px 20px;border:1px solid var(--line);
  font-size:9.5px;letter-spacing:.24em;text-transform:uppercase;color:var(--muted);white-space:nowrap;
}


/* ── work: first case dominant, rest listed ── */
.lead-case{border-top:1px solid var(--line);padding:54px 0 0;margin-top:68px}
.lead-case .tag{font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:var(--dim);margin:0 0 26px}
.lead-case h2{
  font-family:var(--serif);font-weight:300;margin:0 0 34px;
  font-size:clamp(38px,7.4vw,104px);line-height:.94;letter-spacing:-.032em;color:var(--bright);max-width:13em;
}
.lead-case h2 em{font-style:italic;color:var(--pink)}
.lead-grid{display:grid;grid-template-columns:1fr;gap:34px;padding-bottom:52px}
.lead-case ul{margin:0;padding:0;list-style:none;max-width:40ch}
.lead-case li{padding:0 0 18px 0;border-bottom:1px solid var(--line);margin-bottom:18px;color:var(--muted);font-size:15.5px;line-height:1.62}
.lead-case li:last-child{border-bottom:0}
.wide{
  aspect-ratio:16/10;background:var(--panel);border:1px solid var(--line);
  display:flex;align-items:center;justify-content:center;text-align:center;padding:26px;
  color:var(--dim);font-size:10px;letter-spacing:.24em;text-transform:uppercase;line-height:2.4;
  overflow:hidden;
}
.wide span{will-change:transform;display:block}


.row{display:grid;grid-template-columns:1fr;gap:14px;padding:32px 0;border-top:1px solid var(--line);transition:background .5s var(--e)}
.row:hover{background:var(--shell)}
.row:last-of-type{border-bottom:1px solid var(--line)}
.row .k{font-family:var(--serif);font-style:italic;font-size:30px;color:var(--dim);line-height:1}
.row h3{font-family:var(--serif);font-weight:400;font-size:clamp(25px,3.2vw,38px);line-height:1.06;letter-spacing:-.022em;margin:0 0 8px;color:var(--bright)}
.row .who{font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:var(--dim);margin:0}
.row ul{margin:0;padding:0;list-style:none}
.row li{color:var(--muted);font-size:15px;line-height:1.62;padding-bottom:11px}


/* ── method: prose, not a card grid ──── */
.method{padding:88px 0}
.method h2{
  font-family:var(--serif);font-weight:300;font-size:clamp(32px,5vw,58px);
  line-height:1.06;letter-spacing:-.028em;margin:0 0 56px;color:var(--bright);max-width:11em;
}
.method h2 em{font-style:italic;color:var(--pink)}
.mlist{display:grid;grid-template-columns:1fr;gap:0}
.mlist div{padding:26px 0;border-top:1px solid var(--line)}
.mlist h4{font-family:var(--serif);font-weight:400;font-size:23px;margin:0 0 8px;color:var(--pink)}
.mlist p{margin:0;font-size:15.5px;color:var(--muted);line-height:1.66;max-width:38ch}


/* ── career ──────────────────────────── */
.jobs{padding-bottom:88px}
.job{display:grid;grid-template-columns:1fr;gap:6px;padding:20px 0;border-top:1px solid var(--line)}


.job:last-child{border-bottom:1px solid var(--line)}
.job h4{font-family:var(--serif);font-weight:400;font-size:24px;margin:0;color:var(--bright);transition:color .4s var(--e),transform .45s var(--e)}
.job h4 .sum{display:block;font-family:var(--sans);font-size:14.5px;font-weight:300;
  color:var(--muted);margin-top:12px;max-width:52ch;line-height:1.62;letter-spacing:0}
.job h4 small{display:block;font-family:var(--sans);font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:var(--dim);margin-top:6px;font-weight:400}
.job time{font-size:12px;letter-spacing:.12em;color:var(--muted);text-align:left;white-space:nowrap;transition:transform .45s var(--e)}
.job.now h4::after{content:"Now";font-family:var(--sans);font-size:9px;letter-spacing:.2em;text-transform:uppercase;border:1px solid var(--pink);color:var(--pink);padding:3px 9px;margin-left:14px;vertical-align:5px}


/* ── close ───────────────────────────── */
.close{padding:92px 0 46px;border-top:1px solid var(--line)}
.close h2{
  font-family:var(--serif);font-weight:300;margin:0 0 40px;
  font-size:clamp(50px,11vw,150px);line-height:.88;letter-spacing:-.038em;color:var(--bright);
}
.close h2 em{font-style:italic;color:var(--pink)}
.cta{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
.btn{
  position:relative;overflow:hidden;text-decoration:none;
  padding:17px 40px;font-size:10px;letter-spacing:.26em;text-transform:uppercase;
  border:1px solid var(--pink);color:var(--pink);
  transition:color .5s var(--e);
}
.btn span{position:relative;z-index:2}
.btn::before{content:"";position:absolute;inset:0;background:var(--pink);transform:translate3d(0,101%,0);transition:transform .55s var(--e)}
.btn:hover{color:var(--wine)}
.btn:hover::before{transform:translateY(0)}
.btn.fill{background:var(--pink);color:var(--wine)}
.btn.fill::before{background:var(--bright)}
.foot{margin-top:120px;padding-top:24px;border-top:1px solid var(--line);
  display:flex;justify-content:space-between;gap:14px 24px;flex-wrap:wrap;
  font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--dim)}
.foot .by a{color:var(--muted);text-decoration:none;border-bottom:1px solid transparent;
  padding-bottom:2px;transition:color .4s var(--e),border-color .4s var(--e)}
.foot .by a:hover{color:var(--pink);border-bottom-color:var(--pink)}





/* ── mobile menu ────────────────────── */
.nb{display:block;position:relative;width:34px;height:34px;padding:0;border:0;
  background:transparent;cursor:pointer;z-index:70}
.nb span{position:absolute;left:4px;width:26px;height:1px;background:var(--pink);
  transition:transform .45s var(--e),opacity .3s var(--e)}
.nb span:first-child{top:13px}
.nb span:last-child{top:20px}
.nb[aria-expanded="true"] span:first-child{transform:translateY(3.5px) rotate(45deg)}
.nb[aria-expanded="true"] span:last-child{transform:translateY(-3.5px) rotate(-45deg)}
.nmenu{position:fixed;inset:0;z-index:65;background:var(--wine);
  display:flex;align-items:center;opacity:0;pointer-events:none;
  transition:opacity .45s var(--e)}
.nmenu.open{opacity:1;pointer-events:auto}
.nmenu a{display:block;text-decoration:none;font-family:var(--serif);font-weight:300;
  font-size:clamp(34px,10vw,54px);line-height:1.22;letter-spacing:-.02em;
  color:var(--bright);padding:7px 0;
  opacity:0;transform:translate3d(0,16px,0);
  transition:opacity .5s var(--e),transform .5s var(--e),color .3s var(--e)}
.nmenu.open a{opacity:1;transform:none;transition-delay:calc(var(--i) * 60ms + 90ms)}
.nmenu a:active{color:var(--pink)}
body.locked{overflow:hidden}



/* ── home: work index ───────────────── */
.w-eyebrow{font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:var(--dim);margin:0 0 20px}
.w-head{font-family:var(--serif);font-weight:300;font-size:clamp(34px,6vw,76px);
  line-height:.98;letter-spacing:-.03em;margin:0 0 54px;color:var(--bright)}
.w-head em{font-style:italic;color:var(--pink)}
.w-list{border-top:1px solid var(--line)}
.w-group{font-size:9.5px;letter-spacing:.3em;text-transform:uppercase;color:var(--pink);
  margin:0;padding:34px 0 14px;border-bottom:1px solid var(--line)}
.w-group:first-child{padding-top:22px}
.w-item{display:grid;grid-template-columns:40px minmax(0,1fr) 26px;gap:15px;align-items:center;padding:26px 0;border-bottom:1px solid var(--line);text-decoration:none;position:relative;}

.w-item::before{
  content:"";position:absolute;inset:0 -18px;background:var(--shell);
  opacity:0;transition:opacity .45s var(--e);z-index:-1;
}
.w-item:hover > *{transform:translate3d(13px,0,0)}
.w-item:hover::before{opacity:1}
.w-n{font-family:var(--serif);font-style:italic;font-size:26px;color:var(--dim);
  line-height:1;transition:color .45s var(--e),transform .5s var(--e)}
.w-item:hover .w-n{color:var(--pink)}
.w-title{display:block;font-family:var(--serif);font-weight:400;
  font-size:clamp(23px,3vw,34px);line-height:1.08;letter-spacing:-.022em;
  color:var(--bright);transition:color .45s var(--e),transform .5s var(--e)}
.w-item:hover .w-title{color:var(--pink)}
.w-sum{display:block;margin-top:9px;font-size:15px;line-height:1.6;
  color:var(--muted);max-width:52ch;transition:transform .5s var(--e)}
.w-client{display:none;transition:transform .5s var(--e)}
.w-go{font-size:19px;color:var(--dim);text-align:right;
  transition:transform .5s var(--e),color .45s var(--e)}
.w-item:hover .w-go{transform:translate3d(20px,0,0);color:var(--pink)}


/* ── case study page ────────────────── */
.case-page{padding:110px 0 62px}
.back{display:inline-flex;align-items:center;gap:10px;text-decoration:none;
  font-size:10px;letter-spacing:.26em;text-transform:uppercase;color:var(--muted);
  margin-bottom:58px;transition:color .4s var(--e)}
.back .arr{display:inline-block;transition:transform .4s var(--e)}
.back:hover{color:var(--pink)}
.back:hover .arr{transform:translate3d(-5px,0,0)}
.cp-num{font-family:var(--serif);font-style:italic;font-size:clamp(34px,5vw,56px);
  color:var(--dim);line-height:1;margin:0 0 12px}
.cp-title{font-family:var(--serif);font-weight:300;margin:0 0 44px;
  font-size:clamp(38px,7.6vw,104px);line-height:.95;letter-spacing:-.034em;
  color:var(--bright);max-width:14em}
.cp-title em{font-style:italic;color:var(--pink)}
.cp-meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,auto));justify-content:start;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:62px}
.cp-meta div{padding:16px 24px 18px 0;margin-right:24px;border-right:1px solid var(--line)}
.cp-meta div:last-child{border-right:0;margin-right:0}
@supports(selector(:has(*))){.cp-meta div:nth-last-child(1){border-right:0}}
.cp-meta span:first-child{display:block;font-size:9.5px;letter-spacing:.24em;
  text-transform:uppercase;color:var(--dim);margin-bottom:7px}
.cp-meta span:last-child{font-size:16px;color:var(--pink)}
.cp-hero{border:1px solid var(--line);background:var(--panel);margin-bottom:68px;overflow:hidden}
.cp-hero img{width:100%;height:auto;display:block}
.cp-body{display:grid;grid-template-columns:1fr;gap:38px;margin-bottom:46px}
.cp-body.solo{grid-template-columns:minmax(0,1fr);max-width:62ch}
.cp-body.solo .cp-points li{font-size:16.5px}
.cp-lbl{font-size:9.5px;letter-spacing:.26em;text-transform:uppercase;
  color:var(--dim);margin:0 0 20px}
.cp-points{margin:0;padding:0;list-style:none}
.cp-points li{padding:0 0 16px;border-bottom:1px solid var(--line);margin-bottom:16px;
  color:var(--muted);font-size:15.5px;line-height:1.66}
.cp-points li:last-child{border-bottom:0}
.cp-prose{font-size:17px;line-height:1.78;color:var(--muted)}
.cp-prose h2{font-family:var(--serif);font-weight:300;font-size:clamp(26px,3.4vw,40px);
  line-height:1.1;letter-spacing:-.025em;color:var(--bright);margin:44px 0 18px}
.cp-prose h2:first-child{margin-top:0}
.cp-prose h3{font-family:var(--serif);font-weight:400;font-size:23px;color:var(--pink);margin:34px 0 12px}
.cp-prose p{margin:0 0 20px}
.cp-prose strong{font-weight:400;color:var(--bright)}
.cp-prose a{color:var(--pink)}
.cp-prose blockquote{margin:30px 0;padding-left:26px;border-left:1px solid var(--pink);
  font-family:var(--serif);font-style:italic;font-size:22px;line-height:1.45;color:var(--bright)}
.cp-prose ul,.cp-prose ol{margin:0 0 20px;padding-left:20px}
.cp-prose li{padding-bottom:9px}
.cp-gallery{display:grid;grid-template-columns:1fr;gap:18px;margin-bottom:50px}
.cp-gallery figure{margin:0}
.cp-gallery img{width:100%;border:1px solid var(--line);background:var(--panel);display:block}
.cp-gallery figcaption{margin-top:12px;font-size:12px;color:var(--dim);letter-spacing:.04em}
.cp-gallery figure:only-child{grid-column:1/-1}
.cp-nav{display:grid;grid-template-columns:1fr;gap:26px;border-top:1px solid var(--line);padding-top:32px;margin-top:20px}
.cp-link{text-decoration:none;display:block;transition:transform .4s var(--e);will-change:transform}
.cp-link.next{text-align:left}
.cp-link .lbl{display:block;font-size:9.5px;letter-spacing:.26em;text-transform:uppercase;
  color:var(--dim);margin-bottom:10px}
.cp-link .ttl{font-family:var(--serif);font-weight:400;font-size:clamp(20px,2.6vw,30px);
  line-height:1.12;color:var(--bright);transition:color .4s var(--e)}
.cp-link.prev:hover{transform:translate3d(-6px,0,0)}
.cp-link.next:hover{transform:translate3d(6px,0,0)}
.cp-link:hover .ttl{color:var(--pink)}



.case-a{text-decoration:none;color:inherit;transition:color .4s var(--e)}
.case-a:hover{color:var(--pink)}
.more{display:inline-flex;align-items:center;gap:11px;text-decoration:none;
  font-size:10px;letter-spacing:.26em;text-transform:uppercase;color:var(--pink);
  margin-top:26px;padding-bottom:5px;border-bottom:1px solid var(--line);
  transition:border-color .45s var(--e)}
.more:after{content:"\2192";transition:transform .45s var(--e)}
.more:hover{border-bottom-color:var(--pink)}
.more:hover:after{transform:translate3d(6px,0,0)}


/* ── designed placeholder panel ─────── */
.cp-hero.plate{background:var(--shell);border:1px solid var(--line);
  aspect-ratio:16/9;display:flex;align-items:flex-end;position:relative;overflow:hidden}
.cp-hero.plate::after{content:"";position:absolute;inset:0;pointer-events:none;
  background:
    repeating-linear-gradient(90deg,transparent 0 var(--c),var(--line) var(--c),var(--line) calc(var(--c) + 1px));
  --c:12.5%;opacity:.5}
.plate-in{position:relative;z-index:2;padding:clamp(22px,4vw,54px);width:100%;
  display:grid;gap:10px}
.plate-n{font-family:var(--serif);font-style:italic;font-size:clamp(44px,9vw,120px);
  line-height:.8;color:var(--pink);opacity:.5}
.plate-c{font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:var(--dim)}
.plate-t{font-family:var(--serif);font-weight:300;font-size:clamp(20px,2.6vw,34px);
  line-height:1.1;color:var(--bright);max-width:22ch}
.plate-s{font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}

/* ── scroll reveal: clip wipe ───────── */
[data-reveal]{clip-path:inset(0 0 100% 0);transition:clip-path 1.05s var(--e)}
[data-reveal].shown{clip-path:inset(0 0 0 0)}

/* ── custom cursor ──────────────────── */
.cur{position:fixed;top:0;left:0;width:11px;height:11px;border-radius:50%;
  background:var(--pink);pointer-events:none;z-index:200;opacity:0;
  transform:translate3d(-50%,-50%,0);
  transition:opacity .3s var(--e),width .35s var(--e),height .35s var(--e),background .35s var(--e)}
.cur.on{opacity:1}
.cur.big{width:46px;height:46px;background:rgba(244,201,221,.16)}
.cur-ring{position:fixed;top:0;left:0;width:30px;height:30px;border-radius:50%;
  border:1px solid rgba(244,201,221,.4);pointer-events:none;z-index:199;opacity:0;
  transform:translate3d(-50%,-50%,0);transition:opacity .3s var(--e)}
.cur-ring.on{opacity:1}
@media(hover:none),(pointer:coarse){.cur,.cur-ring{display:none}}

/* ── page transition ────────────────── */
.wipe{position:fixed;inset:0;z-index:300;background:var(--wine);
  transform:translate3d(0,100%,0);pointer-events:none}
.wipe.in{transform:translate3d(0,0,0);transition:transform .55s var(--e)}
.wipe.out{transform:translate3d(0,-100%,0);transition:transform .6s var(--e)}

/* ── reveal ──────────────────────────── */
.rv{opacity:0;transform:translate3d(0,26px,0);transition:opacity .9s var(--e),transform .9s var(--e);will-change:opacity,transform}
.rv.in{will-change:auto}
.rv.in{opacity:1;transform:none}
.rv.b{transition-delay:.12s}
a:focus-visible{outline:2px solid var(--pink);outline-offset:5px}



/* ══ TABLET  ≥600 ═══════════════════════════════════ */
@media(min-width:600px){
  .w{padding:0 32px}
  .nums{grid-template-columns:repeat(4,1fr);margin-top:72px}
  .nums div{padding:24px 18px 26px 0}
  .cp-nav{grid-template-columns:1fr 1fr;gap:24px}
  .cp-link.next{text-align:right}
  .job{grid-template-columns:minmax(0,1fr) 170px;gap:28px;align-items:baseline;padding:22px 0}
  .job time{text-align:right}
}

/* ══ LARGE TABLET  ≥820 ═════════════════════════════ */
@media(min-width:820px){
  .w{padding:0 40px}
  .mlist{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0 56px}
  .cp-gallery{grid-template-columns:1fr 1fr;gap:22px}
  .cp-body{grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:52px}
  .w-item{grid-template-columns:52px minmax(0,1fr) minmax(0,170px) 34px;gap:22px;padding:30px 0}
  .w-client{display:block;font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--dim);text-align:right}
  .row{grid-template-columns:56px minmax(0,1fr) minmax(0,.9fr);gap:32px;padding:44px 0}
  .hero{padding:150px 0 0}
  .case-page{padding:132px 0 76px}
}

/* ══ LAPTOP  ≥1024 ══════════════════════════════════ */
@media(min-width:1024px){
  .w{max-width:1240px;padding:0 44px}
  .nl{display:flex}
  .nb{display:none}
  .nmenu{display:none}
  .bio{grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:72px;padding-bottom:130px}
  .shot{margin-top:-70px;max-width:none}
  .lead-grid{grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:62px;align-items:end;padding-bottom:78px}
  .lead-case{padding:84px 0 0;margin-top:112px}
  .cp-body{gap:70px;margin-bottom:64px}
  .w-item{grid-template-columns:62px minmax(0,1fr) minmax(0,200px) 40px;gap:28px;padding:36px 0}
  .row{grid-template-columns:64px minmax(0,1fr) minmax(0,.9fr);gap:44px;padding:52px 0}
  .job{grid-template-columns:minmax(0,1fr) 210px;gap:40px}
  .mlist{gap:0 80px}
  .hero{padding:176px 0 0}
  .say{padding:140px 0 120px}
  .method{padding:140px 0}
  .jobs{padding-bottom:140px}
  .close{padding:150px 0 54px}
  .case-page{padding:150px 0 90px}
  .cp-meta div{padding:20px 44px 22px 0;margin-right:44px}
}

/* ══ DESKTOP  ≥1440 ═════════════════════════════════ */
@media(min-width:1440px){
  .w{max-width:1340px;padding:0 56px}
  .bio{gap:100px}
  .lead-grid{gap:76px}
  .cp-body{gap:76px}
}

/* ══ LARGE DESKTOP / TV  ≥1800 ══════════════════════ */
@media(min-width:1800px){
  :root{--step:1.12}
  body{font-size:18px}
  .w{max-width:1560px;padding:0 72px}
  .sub{font-size:clamp(19px,1.5vw,26px)}
  .nums b{font-size:clamp(46px,3.6vw,76px)}
  .w-sum{font-size:16.5px;max-width:58ch}
  .cp-prose{font-size:18.5px}
  .bio p{font-size:18.5px}
  .mlist p{font-size:17px}
  .row li,.cp-points li,.lead-case li{font-size:17px}
}

/* ══ ULTRA-WIDE  ≥2400 ══════════════════════════════ */
@media(min-width:2400px){
  body{font-size:20px}
  .w{max-width:1760px}
  .cp-prose{font-size:20px}
  .bio p{font-size:20px}
}

@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *{transition:none!important;animation:none!important}
  .msk > span{transform:none}
  .fade,.rv{opacity:1;transform:none}
  .say .wd{opacity:1}
}
</style>
</head>
<body>


<nav id="nav">
  <div class="w">
    <a class="mark" href="{{ '/' | url }}">{{ site.name.split(' ')[0] }} <i>{{ site.name.split(' ')[1] }}</i></a>
    <div class="nl">
      {% for n in site.navItems %}<a href="{{ '/' | url }}#{{ n.anchor }}">{{ n.label }}</a>
      {% endfor %}
    </div>

    <button class="nb" id="nb" aria-expanded="false" aria-controls="nmenu" aria-label="Open menu">
      <span></span><span></span>
    </button>
  </div>
</nav>

<div class="wipe" id="wipe"></div>
<div class="cur" id="cur"></div>
<div class="cur-ring" id="curRing"></div>

<div class="nmenu" id="nmenu" hidden>
  <div class="w">
    {% for n in site.navItems %}<a href="{{ '/' | url }}#{{ n.anchor }}" style="--i:{{ loop.index0 }}">{{ n.label }}</a>
    {% endfor %}
    <a href="mailto:{{ site.email }}" style="--i:{{ site.navItems | length }}">{{ site.emailLabel }}</a>
  </div>
</div>

{{ content | safe }}
<footer class="close" id="contact">
  <div class="w">
    <h2 class="rv">{{ site.closeHeading }} <em>{{ site.closeHeadingItalic }}</em>.</h2>
    <div class="cta rv b">
      <a class="btn fill" href="mailto:{{ site.email }}"><span>{{ site.emailLabel }}</span></a>
      {% if site.linkedin %}<a class="btn" href="{{ site.linkedin }}"><span>{{ site.linkedinLabel }}</span></a>{% endif %}
    </div>
    <div class="foot">
      <span>&copy; <i id="y">2026</i> {{ site.name }}</span>
      <span>{{ site.city }}</span>
      <span class="by">Designed by <a href="https://hinali.com" rel="noopener">Hinali Shah</a></span>
    </div>
  </div>
</footer>

<script>

(function () {
  'use strict';
  var slow = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var yr = document.getElementById('y');
  if (yr) yr.textContent = new Date().getFullYear();

  var say = document.getElementById('say');
  var nav = document.getElementById('nav');

  var nb = document.getElementById('nb');
  var nmenu = document.getElementById('nmenu');
  if (nb && nmenu) {
    var setMenu = function (open) {
      nb.setAttribute('aria-expanded', open ? 'true' : 'false');
      nb.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.classList.toggle('locked', open);
      if (open) {
        nmenu.hidden = false;
        requestAnimationFrame(function () { nmenu.classList.add('open'); });
      } else {
        nmenu.classList.remove('open');
        setTimeout(function () { if (!nmenu.classList.contains('open')) nmenu.hidden = true; }, 450);
      }
    };
    nb.addEventListener('click', function () {
      setMenu(nb.getAttribute('aria-expanded') !== 'true');
    });
    nmenu.addEventListener('click', function (e) {
      if (e.target.tagName === 'A') setMenu(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && nb.getAttribute('aria-expanded') === 'true') setMenu(false);
    });
    window.addEventListener('resize', function () {
      if (window.innerWidth > 780 && nb.getAttribute('aria-expanded') === 'true') setMenu(false);
    });
  }

  if (slow) {
    document.body.classList.add('go');
    document.querySelectorAll('.rv').forEach(function (n) { n.classList.add('in'); });
    return;
  }

  requestAnimationFrame(function () { document.body.classList.add('go'); });

  if (say) {
    say.innerHTML = say.innerHTML.replace(/(<em>)?([^<\s]+)/g, function (m, em, word) {
      return (em || '') + '<span class="wd">' + word + '</span>';
    });
    say.querySelectorAll('.wd').forEach(function (s, i) {
      s.style.transitionDelay = (i * 44) + 'ms';
    });
  }

  var io = new IntersectionObserver(function (es) {
    es.forEach(function (e) {
      if (!e.isIntersecting) return;
      if (e.target === say) say.classList.add('lit');
      else e.target.classList.add('in');
      io.unobserve(e.target);
    });
  }, { rootMargin: '0px 0px -10% 0px', threshold: 0.15 });

  document.querySelectorAll('.rv').forEach(function (n) { io.observe(n); });
  if (say) io.observe(say);

  var par = document.querySelectorAll('[data-p]');
  var tick = false;
  function run() {
    tick = false;
    if (nav) nav.classList.toggle('on', window.scrollY > 90);
    var vh = window.innerHeight;
    par.forEach(function (p) {
      var r = p.parentNode.getBoundingClientRect();
      if (r.bottom < -120 || r.top > vh + 120) return;
      var t = (r.top + r.height / 2 - vh / 2) / vh;
      p.style.transform = 'translate3d(0,' + (t * -20).toFixed(2) + 'px,0)';
    });
  }
  window.addEventListener('scroll', function () {
    if (!tick) { tick = true; requestAnimationFrame(run); }
  }, { passive: true });
  window.addEventListener('resize', run, { passive: true });
  run();

  // ---- clip-wipe reveals ----
  // clip-path hides the node from IntersectionObserver, so watch its parent
  var rv = document.querySelectorAll('[data-reveal]');
  if (rv.length) {
    var pairs = [];
    rv.forEach(function (n) { if (n.parentElement) pairs.push([n.parentElement, n]); });
    var rio = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (!e.isIntersecting) return;
        pairs.forEach(function (p) { if (p[0] === e.target) p[1].classList.add('shown'); });
        rio.unobserve(e.target);
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
    pairs.forEach(function (p) { rio.observe(p[0]); });
  }

  // ---- custom cursor ----
  var cur = document.getElementById('cur');
  var ring = document.getElementById('curRing');
  if (cur && ring && window.matchMedia('(hover:hover) and (pointer:fine)').matches) {
    var cx = 0, cy = 0, rx = 0, ry = 0, raf = null;
    var loop = function () {
      rx += (cx - rx) * 0.16;
      ry += (cy - ry) * 0.16;
      ring.style.transform = 'translate3d(' + rx + 'px,' + ry + 'px,0) translate(-50%,-50%)';
      raf = requestAnimationFrame(loop);
    };
    document.addEventListener('mousemove', function (e) {
      cx = e.clientX; cy = e.clientY;
      cur.style.transform = 'translate3d(' + cx + 'px,' + cy + 'px,0) translate(-50%,-50%)';
      if (!cur.classList.contains('on')) {
        cur.classList.add('on'); ring.classList.add('on');
        if (!raf) loop();
      }
    }, { passive: true });
    document.addEventListener('mouseleave', function () {
      cur.classList.remove('on'); ring.classList.remove('on');
    });
    var hot = 'a, button, .w-item, .cp-link';
    document.addEventListener('mouseover', function (e) {
      if (e.target.closest(hot)) cur.classList.add('big');
    });
    document.addEventListener('mouseout', function (e) {
      if (e.target.closest(hot)) cur.classList.remove('big');
    });
  }

  // ---- page transition ----
  var wipe = document.getElementById('wipe');
  if (wipe) {
    document.addEventListener('click', function (e) {
      var a = e.target.closest('a[href]');
      if (!a) return;
      var href = a.getAttribute('href');
      if (!href || href.charAt(0) === '#' || a.target === '_blank') return;
      if (href.indexOf('mailto:') === 0 || href.indexOf('http') === 0) return;
      e.preventDefault();
      wipe.classList.add('in');
      setTimeout(function () { window.location.href = href; }, 480);
    });
    window.addEventListener('pageshow', function () {
      wipe.classList.remove('in');
      wipe.classList.add('out');
      setTimeout(function () { wipe.classList.remove('out'); }, 650);
    });
  }
}());
</script>
</body>
</html>
